# Separate Neon database/branch for each environment. Never share production with previews.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Production: https://surfingcowarena.com
# Previews: use a stable preview hostname with its own Google OAuth callback.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated exact domains and/or full addresses. Empty lists deny everyone.
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=
